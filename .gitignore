# Large third-party content roots — ignore assets but keep .meta for GUID preservation.
Assets/UMA/
Assets/UMA.meta
Assets/03_ThirdParty/**
!Assets/03_ThirdParty/**/*.meta

# Common oversized distribution archives (Git cannot ignore by file size, so ignore by artifact type)
*.unitypackage
*.unitypackage.meta
*.zip
*.zip.meta
*.7z
*.7z.meta
*.rar
*.rar.meta
*.tar
*.tar.meta
*.gz
*.gz.meta
*.tgz
*.tgz.meta

# Ignore raw third-party package archives; keep imported project assets tracked.
Assets/GameReady3D/**/*.unitypackage
Assets/GameReady3D/**/*.unitypackage.meta

# Untracked third-party demo/scene content — keep local but never commit
Assets/03_ThirdParty/EasyRoads3D scenes/

# CodeWhale / editor session state
.context/
.continue/

# Python virtualenv
.venv/

# Unity auto-generated artifacts (should never be committed)
UIElementsSchema/
GeneratedAssets/

# Tool output and profiling
qodana-results/
ProfilerCaptures/

# Local game save data
Saves/

# Generated building-complete proxy assets — local only
Assets/02_Shared/Proxies/Buildings_Complete/
Assets/02_Shared/Proxies/Buildings_Complete.meta

# CGAxis Downtown kit — local only (large third-party content)
Assets/02_Shared/CG_Downtown/
Assets/02_Shared/CG_Downtown.meta
